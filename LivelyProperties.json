{
  "labelFilter": {
    "type": "label",
    "value": "Filters (Down if laggy)"
  },
  "backgroundBlur": {
    "min": 0,
    "max": 25,
    "step": 1,
    "text": "Background Blur",
    "help": "Higher values make background blurrier.",
    "type": "slider",
    "value": 2
  },
  "foregroundBlur": {
    "min": 0,
    "max": 25,
    "step": 1,
    "text": "Foreground Blur",
    "help": "Higher values make foreground blurrier.",
    "type": "slider",
    "value": 2
  },
  "blur": {
    "min": 0,
    "max": 25,
    "step": 1,
    "text": "Visualizer Blur",
    "help": "Higher values make bars blurrier. (4 is worst performance)",
    "type": "slider",
    "value": 2
  },
  "contrast": {
    "min": 0,
    "max": 200,
    "step": 5,
    "text": "Contrast",
    "help": "Higher values make colors pop. Default 100",
    "type": "slider",
    "value": 100
  },
  "filters": {
    "type": "textbox",
    "text": "Other CSS Filters",
    "value": "",
    "help": "Try invert(100%)"
  },
  "visualizerSize": {
    "min": 100,
    "max": 2000,
    "step": 10,
    "text": "Circle Size",
    "help": "The center circle's size. Default 300",
    "type": "slider",
    "value": 300
  },
  "labelVolume": {
    "type": "label",
    "value": "Volume"
  },
  "indexMultiplier": {
    "min": 0,
    "max": 50,
    "step": 1,
    "text": "Index Multiplier",
    "help": "Makes the right bigger. Default 10",
    "type": "slider",
    "value": 10
  },
  "doAverageMult": {
    "type": "checkbox",
    "value": true,
    "help": "volume *= 1+avMult/(average+avMultShift)",
    "text": "Average Multiplier"
  },
  "averageMultShift": {
    "min": 0.01,
    "max": 1,
    "step": 0.005,
    "text": "Average Multiplier Shift",
    "help": "Down for more accuracy, Default 0.02",
    "type": "slider",
    "value": 0.020
  },
  "averageMult": {
    "min": 0,
    "max": 100,
    "step": 0.1,
    "text": "Average Multiplier",
    "help": "Multiplier for averager, Default 1.6",
    "type": "slider",
    "value": 1.6
  },
  "doTan": {
    "type": "checkbox",
    "value": false,
    "help": "volume = maxVolume*(PI/2+atan(tanMult*volume+tanX))",
    "text": "Use Inverse Tan (Buggy)"
  },
  "tanMult": {
    "min": 0.01,
    "max": 10.00,
    "step": 0.01,
    "text": "tan Multiplier",
    "help": "atan(THIS*volume+tanX)",
    "type": "slider",
    "value": 1.5
  },
  "tanX": {
    "min": 0,
    "max": 200,
    "step": 1,
    "text": "tanX",
    "help": "atan(tanMult*volume+THIS)",
    "type": "slider",
    "value": 50
  },
  "maxVolume": {
    "min": 0,
    "max": 5000,
    "step": 10,
    "text": "Maximum Volume",
    "help": "Highest Volume",
    "type": "slider",
    "value": 1000
  },
  "volumeMultiplier": {
    "min": 0,
    "max": 1000,
    "step": 1,
    "text": "Volume Multiplier",
    "help": "Disabled if using atan",
    "type": "slider",
    "value": 15
  },
  "labelVisuals": {
    "type": "label",
    "value": "Visuals"
  },
  "volumeColorMult": {
    "min": 0,
    "max": 1,
    "step": 0.002,
    "text": "Volume Color Multiplier",
    "help": "Color changes with volume, Default 0.15",
    "type": "slider",
    "value": 0.150
  },
  "heightMin": {
    "min": -200,
    "max": 200,
    "step": 2,
    "text": "Minimum Height",
    "help": "0 for bars to be at the visualizer size",
    "type": "slider",
    "value": 0
  },
  "heightMax": {
    "min": 0,
    "max": 500,
    "step": 2,
    "text": "Maximum Height",
    "help": "0 for no Height, Default 200",
    "type": "slider",
    "value": 200
  },
  "heightMultiplier": {
    "min": 0,
    "max": 2,
    "step": 0.005,
    "text": "Height Multiplier",
    "help": "Makes bars go Up/Down. Default 0.01",
    "type": "slider",
    "value": 0.01
  },
  "scaleX": {
    "min": 0.000,
    "max": 0.050,
    "step": 0.001,
    "text": "X Scaling",
    "help": "Scale Bars Sideways. Default 0.010",
    "type": "slider",
    "value": 0.010
  },
  "scaleXMin": {
    "min": 0.01,
    "max": 3.00,
    "step": 0.01,
    "text": "Minimum X Scale",
    "help": "Scale Bars Sideways. Default 2.00",
    "type": "slider",
    "value": 2.00
  },
  "scaleY": {
    "min": 0.01,
    "max": 1.00,
    "step": 0.01,
    "text": "Y Scaling",
    "help": "Scale Bars Up. Default 0.10",
    "type": "slider",
    "value": 0.10
  },
  "transition": {
    "min": 0,
    "max": 1,
    "step": 0.01,
    "text": "Transition Speed",
    "help": "How smooth the bars transition. Default 0.75",
    "type": "slider",
    "value": 0.75
  },
  "labelEnv": {
    "type": "label",
    "value": "Envirounment"
  },
  "baseLocation": {
    "min": 0,
    "max": 127,
    "step": 1,
    "text": "Base Location",
    "help": "Where shake should be calculated from (4 for bass/drums)",
    "type": "slider",
    "value": 4
  },
  "shakeMultiplier": {
    "min": 0,
    "max": 500,
    "step": 2,
    "text": "Shake Multiplier",
    "help": "make em shake",
    "type": "slider",
    "value": 8
  },
  "labelPerformance": {
    "type": "label",
    "value": "Performance"
  },
  "despawnVolume": {
    "min": 0,
    "max": 100,
    "step": 1,
    "text": "Visualizer Despawn Volume",
    "help": "What volume to despawn bars (up for performance)",
    "type": "slider",
    "value": 0
  },
  "diff": {
    "min": 0,
    "max": 0.05,
    "step": 0.001,
    "text": "Rounding",
    "help": "Little effect (up for performance)",
    "type": "slider",
    "value": 0.005
  },
  "fpsLock": {
    "type": "checkbox",
    "value": false,
    "help": "Improves performance, looks okay",
    "text": "30 FPS Lock"
  }
}
